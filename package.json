{
    "name": "surreal-better-auth-monorepo",
    "description": "SurrealDB adapter for Better Auth",
    "keywords": [
      "adapter",
      "auth",
      "authentication",
      "database",
      "better-auth",
      "better-auth-adapter",
      "better-auth-surrealdb-adapter",
      "surreal-better-auth",
      "surrealdb-better-auth",
      "surrealdb-better-auth-adapter",
      "surrealdb",
      "surrealdb-adapter",
      "surrealdb-auth",
      "javascript",
      "typescript"
    ],
    "devDependencies": {
        "@better-auth/cli": "^1.4.21",
        "@better-auth/test-utils": "^1.7.2",
        "@types/bun": "^1.4.0",
        "@types/ws": "^8.18.1",
        "better-auth": "^1.7.2",
        "bun": "^1.4.0",
        "glob": "^13.0.6",
        "nanoid": "^6.0.1",
        "oxfmt": "^0.65.0",
        "oxlint": "^1.80.0",
        "surrealdb": "^2.0.8",
        "tsdown": "^0.22.14",
        "typescript": "^6.0.3",
        "util": "^0.12.5",
        "vitest": "^4.1.11",
        "ws": "^8.21.3"
    },
    "private": true,
    "scripts": {
        "build": "bun run --filter=surreal-better-auth build",
        "build:watch": "bun run --filter=surreal-better-auth build:watch",
        "dev": "bun run --port 3000 --filter=sk --elide-lines=0 dev",
        "t": "cd adapter-tests && bun vitest run test",
        "test:adapter": "bun run t",
        "test:integration": "bun run t",
        "test:all": "bun run t",
        "release:check": "cd packages/surreal-better-auth && npm pack --dry-run",
        "release:version": "cd packages/surreal-better-auth && node -p \"require('./package.json').version\"",
        "release:status": "node scripts/check-release.js",
        "restart": "rm -rfv bun.lock node_modules && find . -name 'node_modules' -type d -exec rm -rfv {} + && find . -name '.svelte-kit' -type d -exec rm -rfv {} +",
        "setup": "bun install && echo '✅ Setup complete! Run: bun run release:status'",
        "create:schema": "bun x @better-auth/cli@latest generate --config ./packages/surreal-better-auth/_auth.ts",
        "run:db": "docker run --rm --pull always -p 8000:8000 surrealdb/surrealdb:latest start"
    },
    "type": "module",
    "workspaces": [
        "packages/*",
        "examples/*"
    ]
}
